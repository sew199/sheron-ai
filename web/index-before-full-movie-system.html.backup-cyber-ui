<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>ZOROX AI — WIKRAMASINGHE TECHNOLOGIES</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
    font-family:Inter,Arial,sans-serif;
    background:#050307;
    color:#fff;
    min-height:100vh;
    overflow-x:hidden
}
button,input{font:inherit}
button{cursor:pointer}

body:before{
    content:"";
    position:fixed;
    width:650px;height:650px;
    left:-300px;top:-300px;
    background:radial-gradient(circle,rgba(255,25,65,.16),transparent 68%);
    pointer-events:none;
    z-index:-3
}
body:after{
    content:"";
    position:fixed;
    width:650px;height:650px;
    right:-300px;bottom:-300px;
    background:radial-gradient(circle,rgba(180,35,120,.13),transparent 68%);
    pointer-events:none;
    z-index:-3
}

.grid{
    position:fixed;
    inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
    background-size:55px 55px;
    mask-image:linear-gradient(to bottom,#000,transparent 92%);
    pointer-events:none;
    z-index:-2
}

/* HEADER */

header{
    position:sticky;
    top:0;
    z-index:100;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 5%;
    background:rgba(5,3,7,.72);
    backdrop-filter:blur(25px);
    border-bottom:1px solid rgba(255,255,255,.07)
}

.brand{
    display:flex;
    align-items:center;
    gap:11px;
    cursor:pointer
}

.logo{
    width:43px;height:43px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:1000;
    font-size:24px;
    color:#fff;
    background:linear-gradient(135deg,#ff174d,#8b102e);
    box-shadow:0 0 30px rgba(255,23,77,.42);
    animation:zPulse 2.6s infinite
}

@keyframes zPulse{
    0%,100%{box-shadow:0 0 20px rgba(255,23,77,.3)}
    50%{box-shadow:0 0 42px rgba(255,23,77,.72)}
}

.brand-text{
    font-weight:900;
    letter-spacing:2px;
    font-size:14px
}
.brand-text span{color:#ff315d}

nav{
    display:flex;
    gap:10px
}
nav button{
    background:transparent;
    border:0;
    color:#8e8992;
    padding:9px 12px;
    transition:.25s
}
nav button:hover{color:#fff}

.header-actions{
    display:flex;
    gap:8px
}

.small-btn{
    border:1px solid rgba(255,255,255,.1);
    background:rgba(255,255,255,.04);
    color:#fff;
    border-radius:11px;
    padding:9px 13px
}

.small-btn.red{
    background:linear-gradient(135deg,#ff174d,#b70f39);
    border:0
}

/* PAGES */

.page{display:none;min-height:calc(100vh - 74px)}
.page.active{display:block}

/* HOME */

.hero{
    min-height:75vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:70px 20px
}

.hero-inner{max-width:950px}

.badge{
    display:inline-flex;
    gap:8px;
    align-items:center;
    padding:9px 17px;
    border-radius:50px;
    border:1px solid rgba(255,40,85,.22);
    background:rgba(255,20,65,.045);
    color:#ff7894;
    font-size:10px;
    letter-spacing:2px;
    margin-bottom:28px
}

.dot{
    width:7px;height:7px;
    border-radius:50%;
    background:#ff174d;
    box-shadow:0 0 13px #ff174d;
    animation:pulse 1.5s infinite
}

@keyframes pulse{50%{opacity:.25}}

h1{
    font-size:clamp(58px,11vw,125px);
    line-height:.88;
    letter-spacing:-7px;
    font-weight:1000
}

.gradient{
    background:linear-gradient(90deg,#fff,#ff365f,#b54cff);
    -webkit-background-clip:text;
    color:transparent
}

.subtitle{
    max-width:690px;
    margin:30px auto;
    color:#8e8792;
    line-height:1.8;
    font-size:16px
}

.hero-buttons{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px
}

.btn{
    border:0;
    padding:14px 22px;
    border-radius:13px;
    font-weight:800;
    color:#fff;
    transition:.25s
}

.btn:hover{transform:translateY(-3px)}

.red-btn{
    background:linear-gradient(135deg,#ff174d,#a80d35);
    box-shadow:0 10px 35px rgba(255,23,77,.18)
}

.dark-btn{
    background:rgba(255,255,255,.045);
    border:1px solid rgba(255,255,255,.1)
}

.feature-grid{
    max-width:1100px;
    margin:0 auto;
    padding:0 6% 90px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px
}

.feature{
    min-height:190px;
    padding:27px;
    border-radius:23px;
    border:1px solid rgba(255,255,255,.07);
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
    backdrop-filter:blur(18px);
    transition:.3s
}
.feature:hover{
    transform:translateY(-7px);
    border-color:rgba(255,30,75,.3)
}
.feature-icon{
    font-size:25px;
    margin-bottom:20px
}
.feature h3{margin-bottom:10px}
.feature p{
    color:#77717b;
    font-size:13px;
    line-height:1.7
}

/* CHAT */

.chat-page{
    max-width:950px;
    margin:auto;
    padding:45px 20px 80px
}

.chat-heading{text-align:center;margin-bottom:25px}
.z-big{
    width:72px;height:72px;
    margin:auto auto 15px;
    border-radius:22px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:34px;
    font-weight:1000;
    background:linear-gradient(135deg,#ff174d,#76102d);
    box-shadow:0 0 45px rgba(255,23,77,.3);
    animation:zPulse 2.5s infinite
}

.chat-heading h2{font-size:38px}
.chat-heading p{color:#77717b;margin-top:7px}

.chat-box{
    height:610px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:25px;
    overflow:hidden;
    background:rgba(9,6,11,.76);
    backdrop-filter:blur(25px);
    box-shadow:0 30px 100px rgba(0,0,0,.45);
    display:flex;
    flex-direction:column
}

.chat-top{
    padding:17px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid rgba(255,255,255,.06)
}

.chat-brand{display:flex;align-items:center;gap:10px}
.mini-z{
    width:34px;height:34px;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#ff174d,#79102d);
    font-weight:900
}
.chat-name{font-weight:800;font-size:14px}
.online{font-size:10px;color:#ff5577;margin-top:3px}

.close{
    width:35px;height:35px;
    border:0;border-radius:10px;
    background:rgba(255,255,255,.05);
    color:#aaa
}

.messages{
    flex:1;
    overflow-y:auto;
    padding:24px;
    display:flex;
    flex-direction:column;
    gap:14px
}

.message{
    max-width:78%;
    padding:13px 16px;
    border-radius:16px;
    line-height:1.6;
    font-size:14px
}
.ai{
    align-self:flex-start;
    background:rgba(255,255,255,.045);
    border:1px solid rgba(255,255,255,.06)
}
.user{
    align-self:flex-end;
    background:linear-gradient(135deg,#e91548,#8b1640)
}

.chat-input{
    display:flex;
    gap:9px;
    padding:14px;
    border-top:1px solid rgba(255,255,255,.06)
}
.chat-input input{
    flex:1;
    outline:0;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.035);
    color:#fff;
    border-radius:13px;
    padding:14px
}
.send{
    width:52px;
    border:0;
    border-radius:13px;
    color:#fff;
    background:linear-gradient(135deg,#ff174d,#951038)
}

/* MEDIA PAGES */

.media-page{
    padding:30px 5% 80px;
    max-width:1250px;
    margin:auto
}

.media-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:24px
}

.back{
    border:1px solid rgba(255,255,255,.09);
    background:rgba(255,255,255,.04);
    color:#fff;
    border-radius:12px;
    padding:10px 15px
}

.media-title h2{font-size:38px}
.media-title p{color:#77717b;margin-top:6px}

.search{
    display:flex;
    gap:9px;
    margin-bottom:20px
}
.search input{
    flex:1;
    border:1px solid rgba(255,255,255,.09);
    background:rgba(255,255,255,.035);
    color:#fff;
    outline:0;
    border-radius:14px;
    padding:15px 17px
}
.search button{
    border:0;
    border-radius:14px;
    padding:0 20px;
    color:#fff;
    background:linear-gradient(135deg,#ff174d,#8c1235)
}

.categories{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding-bottom:18px
}
.category{
    white-space:nowrap;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.035);
    color:#aaa;
    border-radius:50px;
    padding:8px 14px
}
.category.active{
    color:#fff;
    border-color:rgba(255,40,80,.4);
    background:rgba(255,25,65,.1)
}

/* MUSIC */

.music-page .search button{
    background:linear-gradient(135deg,#a348ff,#ff4f9a)
}

.music-visual{
    height:190px;
    border-radius:25px;
    margin-bottom:24px;
    overflow:hidden;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
      radial-gradient(circle at 30% 50%,rgba(166,58,255,.32),transparent 30%),
      radial-gradient(circle at 70% 50%,rgba(255,60,145,.25),transparent 30%),
      #0b0710;
    border:1px solid rgba(210,80,255,.14)
}

.visualizer{
    height:90px;
    display:flex;
    align-items:center;
    gap:5px
}
.bar{
    width:5px;
    height:20px;
    border-radius:10px;
    background:linear-gradient(#bd55ff,#ff559c);
    animation:musicBars .8s ease-in-out infinite alternate
}
.bar:nth-child(2n){animation-delay:.2s}
.bar:nth-child(3n){animation-delay:.4s}
.bar:nth-child(4n){animation-delay:.1s}

@keyframes musicBars{
    from{height:12px}
    to{height:75px}
}

.music-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px
}

.media-card{
    min-width:0;
    border:1px solid rgba(255,255,255,.07);
    background:rgba(255,255,255,.025);
    border-radius:18px;
    overflow:hidden;
    transition:.3s
}
.media-card:hover{transform:translateY(-5px)}

.poster{
    width:100%;
    aspect-ratio:2/3;
    object-fit:cover;
    background:#111
}

.album{
    width:100%;
    aspect-ratio:1;
    object-fit:cover;
    background:#111
}

.card-info{padding:13px}
.card-info h3{
    font-size:14px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis
}
.card-info p{
    color:#716a75;
    font-size:11px;
    margin-top:6px
}

.play{
    margin-top:11px;
    width:100%;
    border:0;
    border-radius:10px;
    padding:9px;
    color:#fff;
    background:linear-gradient(135deg,#a644ff,#ff4c99)
}

.movie-grid{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:15px
}

.empty{
    grid-column:1/-1;
    padding:70px 20px;
    text-align:center;
    color:#68616c;
    border:1px dashed rgba(255,255,255,.08);
    border-radius:20px
}

/* AUTH */

.auth{
    max-width:430px;
    margin:70px auto;
    padding:0 20px
}
.auth-box{
    padding:30px;
    border-radius:25px;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.035);
    backdrop-filter:blur(20px)
}
.auth-logo{
    width:58px;height:58px;
    margin:0 auto 17px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:26px;
    font-weight:1000;
    background:linear-gradient(135deg,#ff174d,#80102e)
}
.auth h2{text-align:center;margin-bottom:7px}
.auth p{text-align:center;color:#716a75;font-size:13px;margin-bottom:24px}

.auth input{
    width:100%;
    margin-bottom:11px;
    padding:14px;
    border-radius:12px;
    outline:0;
    border:1px solid rgba(255,255,255,.08);
    background:rgba(0,0,0,.25);
    color:#fff
}

.auth button{
    width:100%;
    padding:14px;
    border:0;
    border-radius:12px;
    background:linear-gradient(135deg,#ff174d,#911033);
    color:#fff;
    font-weight:800
}

.auth-switch{
    margin-top:16px;
    color:#77717b;
    text-align:center;
    font-size:12px
}
.auth-switch button{
    width:auto;
    padding:0;
    background:none;
    color:#ff4b70
}

/* FOOTER */

footer{
    text-align:center;
    padding:40px 20px;
    border-top:1px solid rgba(255,255,255,.06);
    color:#4f4952;
    font-size:11px
}
footer strong{color:#ff315d;letter-spacing:2px}

/* RESPONSIVE */

@media(max-width:850px){
    nav{display:none}
    .feature-grid{grid-template-columns:1fr}
    .movie-grid{grid-template-columns:repeat(2,1fr)}
    .music-grid{grid-template-columns:repeat(2,1fr)}
    .media-title h2{font-size:30px}
}

@media(max-width:600px){
    header{padding:13px 4%}
    .brand-text{font-size:12px}
    .header-actions .small-btn:first-child{display:none}
    h1{letter-spacing:-4px}
    .subtitle{font-size:14px}
    .hero{padding:55px 18px}
    .chat-page{padding:30px 12px}
    .chat-box{height:620px}
    .message{max-width:88%}
    .media-page{padding:25px 14px}
    .media-top{align-items:flex-start}
    .movie-grid{grid-template-columns:repeat(2,1fr);gap:10px}
    .music-grid{grid-template-columns:repeat(2,1fr);gap:10px}
}
</style>
</head>

<body>

<div class="grid"></div>

<header>
    <div class="brand" onclick="showPage('home')">
        <div class="logo">Z</div>
        <div class="brand-text">ZOROX <span>AI</span></div>
    </div>

    <nav>
        <button onclick="showPage('home')">Home</button>
        <button onclick="showPage('ai')">AI</button>
        <button onclick="showPage('movies')">Movies</button>
        <button onclick="showPage('music')">Music</button>
    </nav>

    <div class="header-actions">
        <button class="small-btn" onclick="showPage('login')">Login</button>
        <button class="small-btn red" onclick="showPage('register')">Register</button>
    </div>
</header>


<!-- HOME -->

<section id="home" class="page active">

    <div class="hero">
        <div class="hero-inner">

            <div class="badge">
                <span class="dot"></span>
                ZOROX INTELLIGENCE SYSTEM
            </div>

            <h1>
                ENTER THE<br>
                <span class="gradient">ZOROX ERA.</span>
            </h1>

            <p class="subtitle">
                AI, entertainment and intelligent digital experiences
                brought together inside one next-generation platform.
            </p>

            <div class="hero-buttons">
                <button class="btn red-btn" onclick="showPage('ai')">
                    Meet ZOROX AI
                </button>

                <button class="btn dark-btn" onclick="showPage('movies')">
                    🎬 Movies
                </button>

                <button class="btn dark-btn" onclick="showPage('music')">
                    🎵 Music
                </button>
            </div>

        </div>
    </div>

    <div class="feature-grid">

        <div class="feature">
            <div class="feature-icon">◈</div>
            <h3>Artificial Intelligence</h3>
            <p>
                Talk with ZOROX AI through the live intelligence API.
            </p>
        </div>

        <div class="feature">
            <div class="feature-icon">🎬</div>
            <h3>Movies</h3>
            <p>
                Search real movie data through the connected movie API.
            </p>
        </div>

        <div class="feature">
            <div class="feature-icon">🎵</div>
            <h3>Music</h3>
            <p>
                Discover music through the connected music service.
            </p>
        </div>

    </div>

</section>


<!-- AI -->

<section id="ai" class="page">

    <div class="chat-page">

        <div class="chat-heading">
            <div class="z-big">Z</div>
            <h2>ZOROX AI</h2>
            <p>Your intelligent digital assistant.</p>
        </div>

        <div class="chat-box">

            <div class="chat-top">

                <div class="chat-brand">
                    <div class="mini-z">Z</div>
                    <div>
                        <div class="chat-name">ZOROX AI</div>
                        <div class="online">● LIVE AI</div>
                    </div>
                </div>

                <button class="close" onclick="showPage('home')">×</button>

            </div>

            <div class="messages" id="messages">
                <div class="message ai">
                    Hello 👋 I'm <b>ZOROX AI</b>.<br><br>
                    Ask me anything and I'll connect you to the live AI system.
                </div>
            </div>

            <div class="chat-input">
                <input
                    id="chatInput"
                    placeholder="Message ZOROX AI..."
                    autocomplete="off"
                >
                <button class="send" onclick="sendMessage()">➤</button>
            </div>

        </div>
    </div>

</section>


<!-- MOVIES -->

<section id="movies" class="page">

    <div class="media-page">

        <div class="media-top">
            <div class="media-title">
                <h2>🎬 Movies</h2>
                <p>Discover movies from the connected movie database.</p>
            </div>

            <button class="back" onclick="showPage('home')">
                ← Back
            </button>
        </div>

        <div class="search">
            <input
                id="movieSearch"
                placeholder="Search movies..."
                onkeydown="if(event.key==='Enter')searchMovies()"
            >
            <button onclick="searchMovies()">Search</button>
        </div>

        <div class="categories">
            <button class="category active" onclick="loadTrendingMovies(this)">
                Trending
            </button>
            <button class="category">Action</button>
            <button class="category">Comedy</button>
            <button class="category">Drama</button>
            <button class="category">Horror</button>
            <button class="category">Sci-Fi</button>
            <button class="category">Animation</button>
        </div>

        <div id="movieGrid" class="movie-grid">
            <div class="empty">
                Search for a movie or open this page to load live results.
            </div>
        </div>

    </div>

</section>


<!-- MUSIC -->

<section id="music" class="page music-page">

    <div class="media-page">

        <div class="media-top">
            <div class="media-title">
                <h2>🎵 Music</h2>
                <p>Discover music through ZOROX.</p>
            </div>

            <button class="back" onclick="showPage('home')">
                ← Back
            </button>
        </div>

        <div class="music-visual">

            <div class="visualizer">
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
                <i class="bar"></i><i class="bar"></i>
            </div>

        </div>

        <div class="search">
            <input
                id="musicSearch"
                placeholder="Search artists, songs or music..."
                onkeydown="if(event.key==='Enter')searchMusic()"
            >
            <button onclick="searchMusic()">Search</button>
        </div>

        <div class="categories">
            <button class="category active">All</button>
            <button class="category">Pop</button>
            <button class="category">Hip-Hop</button>
            <button class="category">Rock</button>
            <button class="category">Electronic</button>
            <button class="category">R&B</button>
            <button class="category">Jazz</button>
            <button class="category">Classical</button>
        </div>

        <div id="musicGrid" class="music-grid">
            <div class="empty">
                Search for music to load real results.
            </div>
        </div>

    </div>

</section>


<!-- LOGIN -->

<section id="login" class="page">

    <div class="auth">

        <div class="auth-box">

            <div class="auth-logo">Z</div>

            <h2>Welcome Back</h2>
            <p>Sign in to your ZOROX account.</p>

            <input id="loginEmail" type="email" placeholder="Email">
            <input id="loginPassword" type="password" placeholder="Password">

            <button onclick="loginUser()">Login</button>

            <div class="auth-switch">
                Don't have an account?
                <button onclick="showPage('register')">Register</button>
            </div>

        </div>

    </div>

</section>


<!-- REGISTER -->

<section id="register" class="page">

    <div class="auth">

        <div class="auth-box">

            <div class="auth-logo">Z</div>

            <h2>Create Account</h2>
            <p>Join the ZOROX platform.</p>

            <input id="registerName" type="text" placeholder="Full name">
            <input id="registerEmail" type="email" placeholder="Email">
            <input id="registerPassword" type="password" placeholder="Password">

            <button onclick="registerUser()">Create Account</button>

            <div class="auth-switch">
                Already have an account?
                <button onclick="showPage('login')">Login</button>
            </div>

        </div>

    </div>

</section>


<footer>
    <strong>ZOROX AI</strong>
