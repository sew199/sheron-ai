  outline:0;
  background:rgba(255,255,255,.05);
  color:#fff;
}

.auth-box button{
  width:100%;
  padding:15px;
  border:0;
  border-radius:15px;
  background:linear-gradient(135deg,#fff,#a9f7ff);
  cursor:pointer;
