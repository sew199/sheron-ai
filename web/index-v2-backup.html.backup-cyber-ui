}

.launch:hover{
  transform:translateY(-4px) scale(1.03);
  box-shadow:0 15px 45px rgba(0,234,255,.2);
}

/* MAIN CARDS */
.feature-grid{
  width:min(850px,100%);
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-top:55px;
}

.feature{
  min-height:155px;
  padding:22px;
  border:1px solid rgba(255,255,255,.08);
  border-radius:25px;
  background:rgba(255,255,255,.035);
  backdrop-filter:blur(18px);
  text-align:left;
  cursor:pointer;
  transition:.4s;
