<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Inter,Arial,sans-serif;
  background:#050507;
  color:#fff;
  min-height:100vh;
  overflow-x:hidden;
}

/* BACKGROUND */
body:before{
  content:"";
  position:fixed;
  inset:0;
  z-index:-5;
  background:
    radial-gradient(circle at 15% 20%,rgba(0,234,255,.10),transparent 28%),
    radial-gradient(circle at 85% 30%,rgba(145,70,255,.12),transparent 30%),
    radial-gradient(circle at 50% 90%,rgba(255,40,100,.08),transparent 30%),
    #050507;
}

.grid{
  position:fixed;
  inset:0;
  z-index:-4;
  opacity:.18;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
  background-size:45px 45px;
  mask-image:linear-gradient(to bottom,black,transparent);
}

.orb{
  position:fixed;
  width:260px;
  height:260px;
  border-radius:50%;
  filter:blur(70px);
  opacity:.18;
  z-index:-3;
  animation:float 9s ease-in-out infinite;
}
.orb.one{background:#00eaff;left:-80px;top:15%}
.orb.two{background:#9d4edd;right:-80px;top:50%;animation-delay:-3s}
.orb.three{background:#ff315f;left:40%;bottom:-150px;animation-delay:-6s}

@keyframes float{
  0%,100%{transform:translate(0,0)}
  50%{transform:translate(30px,-35px)}
}

/* HEADER */
header{
  position:fixed;
  top:15px;
  left:50%;
  transform:translateX(-50%);
  width:min(1100px,calc(100% - 24px));
  padding:10px 14px;
  border:1px solid rgba(255,255,255,.08);
  background:rgba(10,10,14,.62);
  backdrop-filter:blur(24px);
  border-radius:24px;
  z-index:100;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
}

.nav{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  cursor:pointer;
}

.logo{
  width:38px;
  height:38px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,#00eaff,#735cff);
  color:#050507;
  font-weight:900;
  box-shadow:0 0 25px rgba(0,234,255,.3);
}

.brand span{
  font-size:13px;
  font-weight:800;
  letter-spacing:1.5px;
}

.navlinks{
  display:flex;
  gap:5px;
}

.navlinks button{
  border:0;
  background:transparent;
  color:#aaa;
  padding:10px 13px;
  border-radius:14px;
  cursor:pointer;
  transition:.3s;
}

.navlinks button:hover{
  color:#fff;
  background:rgba(255,255,255,.07);
}

.auth{
  display:flex;
  gap:6px;
}

.auth button{
  border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.05);
  color:white;
  padding:9px 13px;
  border-radius:13px;
  cursor:pointer;
  transition:.3s;
}

.auth button:hover{
  transform:translateY(-2px);
  background:rgba(255,255,255,.12);
}

/* PAGE */
.page{
  display:none;
  min-height:100vh;
  padding:120px 18px 60px;
  animation:pageIn .45s ease;
}

.page.active{display:block}

@keyframes pageIn{
  from{opacity:0;transform:translateY(15px)}
  to{opacity:1;transform:translateY(0)}
}

/* MAIN */
.hero{
  max-width:1100px;
  margin:auto;
  min-height:calc(100vh - 150px);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.eyebrow{
  padding:7px 13px;
  border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.04);
  border-radius:50px;
  color:#9da0aa;
  font-size:11px;
  letter-spacing:2px;
  margin-bottom:22px;
}

.hero h1{
  font-size:clamp(60px,13vw,145px);
  line-height:.85;
  letter-spacing:-7px;
  background:linear-gradient(120deg,#fff,#8eefff 45%,#9d73ff);
  -webkit-background-clip:text;
  color:transparent;
  text-shadow:0 0 60px rgba(0,234,255,.12);
}

.hero p{
