<script>

/* =========================
   API BASE
========================= */

const API =
      (location.hostname === "127.0.0.1" || location.hostname === "localhost")
        ? "http://127.0.0.1:5000"
        : "";


/* =========================
   PAGE NAVIGATION
========================= */

function showPage(id){

    document.querySelectorAll(".page")
        .forEach(p => p.classList.remove("active"));

    const page = document.getElementById(id);

    if(page){
        page.classList.add("active");
        window.scrollTo({top:0,behavior:"smooth"});
    }

    if(id === "movies"){
        loadDefaultMovies();
        loadTrendingMovies();
    }
}


/* =========================
   ZOROX CHAT
========================= */

async function sendMessage(){

    const input = document.getElementById("chatInput");
    const text = input.value.trim();

    if(!text) return;

    addMessage(text,"user");
    input.value="";

    const typing = document.createElement("div");
    typing.className="message ai";
    typing.id="typing";
    typing.innerHTML="ZOROX is thinking...";
    document.getElementById("messages").appendChild(typing);

    scrollMessages();

    try{

        const response = await fetch(API + "/api/chat",{
            method:"POST",
            headers:{
                "Content-Type":"application/json"
            },
            body:JSON.stringify({
                message:text
            })
        });

        const data = await response.json();

        removeTyping();

        if(data.reply){
            addMessage(data.reply,"ai");
        }else{
            addMessage("ZOROX could not generate a response.","ai");
        }

    }catch(error){

        removeTyping();

        addMessage(
            "Unable to connect to the ZOROX server.",
            "ai"
        );

    }
}


function addMessage(text,type){

    const messages=document.getElementById("messages");

    const div=document.createElement("div");

    div.className="message " + type;

    div.textContent=text;

    messages.appendChild(div);

    scrollMessages();
}


function removeTyping(){

    const typing=document.getElementById("typing");

    if(typing) typing.remove();
}


function scrollMessages(){

    const messages=document.getElementById("messages");

    messages.scrollTop=messages.scrollHeight;
}


document.getElementById("chatInput")
.addEventListener("keydown",function(e){

    if(e.key==="Enter"){
        sendMessage();
    }

});


/* =========================
   ZOROX MOVIES SYSTEM

const movieGenres = {
    28: "Action",
    35: "Comedy",
    18: "Drama",
    27: "Horror",
    878: "Sci-Fi",
    16: "Animation",
    53: "Thriller"
};

function moviePoster(path){
    return path
        ? "https://image.tmdb.org/t/p/w500" + path
        : "";
}

function movieYear(movie){
    const date = movie.release_date || movie.first_air_date || "";
    return date ? date.substring(0,4) : "—";
}

function movieAction(button, type, genreId){

    document.querySelectorAll(".movie-action")
        .forEach(b => b.classList.remove("active"));

    if(button) button.classList.add("active");

    if(type === "trending"){
        loadTrendingMovies();
        return;
    }

    if(type === "popular"){
        loadMovieEndpoint("/api/movies/popular", "Popular Movies");
        return;
    }

    if(type === "now-playing"){
        loadMovieEndpoint("/api/movies/now-playing", "Now Playing");
        return;
    }

    if(type === "genre"){
        loadMovieEndpoint(
            "/api/movies/genre/" + genreId,
            movieGenres[genreId] || "Movies"
        );
    }
}


async function loadMovieEndpoint(endpoint, title){

    const grid = document.getElementById("movieGrid");

    grid.innerHTML = `
        <div class="movie-loading">
            <div class="loader"></div>
            <span>Loading ${escapeHTML(title)}...</span>
        </div>
    `;

    document.getElementById("movieSectionTitle").textContent = title;
    document.getElementById("movieSectionKicker").textContent = "LIVE FROM TMDB";

    try{

        const response = await fetch(API + endpoint);
        const data = await response.json();

        if(!response.ok){
            throw new Error(data.error || "Request failed");
        }

        const results = (data.results || [])
            .filter(movie => movie.media_type === "movie" || !movie.media_type);

        renderMovies(results);

    }catch(error){

        console.error(error);

        grid.innerHTML = `
            <div class="empty">
                Unable to load movies right now.
            </div>
        `;
    }
}


async function loadTrendingMovies(){

    document.getElementById("movieSectionTitle").textContent =
        "Trending Movies";

    document.getElementById("movieSectionKicker").textContent =
        "TRENDING NOW";

    await loadMovieEndpoint(
        "/api/movies/trending",
        "Trending Movies"
    );
}


async function searchMovies(){

    const input = document.getElementById("movieSearch");
    const query = input.value.trim();

    if(!query){
        input.focus();
        return;
    }

    const grid = document.getElementById("movieGrid");

    document.querySelectorAll(".movie-action")
        .forEach(b => b.classList.remove("active"));

    document.getElementById("movieSectionTitle").textContent =
        "Search Results";

    document.getElementById("movieSectionKicker").textContent =
        "SEARCH";

    grid.innerHTML = `
        <div class="movie-loading">
            <div class="loader"></div>
            <span>Searching for ${escapeHTML(query)}...</span>
        </div>
    `;

    try{

        const response = await fetch(
            API + "/api/movies/search?q=" +
            encodeURIComponent(query)
        );

        const data = await response.json();

        if(!response.ok){
            throw new Error(data.error || "Search failed");
        }

        const results = (data.results || [])
            .filter(movie => movie.media_type === "movie");

        renderMovies(results);

    }catch(error){

        console.error(error);

        grid.innerHTML = `
            <div class="empty">
                Movie search failed.
            </div>
        `;
    }
}


function renderMovies(movies){

    const grid = document.getElementById("movieGrid");

    if(!movies.length){

        document.getElementById("movieResultCount").textContent = "";

        grid.innerHTML = `
            <div class="empty">
                No movies found.
            </div>
        `;

        return;
    }

    document.getElementById("movieResultCount").textContent =
        movies.length + " results";

    grid.innerHTML = "";

    movies.forEach((movie, index) => {

        const poster = moviePoster(movie.poster_path);
        const title = movie.title || "Unknown Movie";
        const year = movieYear(movie);
        const rating = movie.vote_average
            ? Number(movie.vote_average).toFixed(1)
            : "—";

        const card = document.createElement("article");

        card.className = "media-card movie-card premium-movie-card";

        card.style.setProperty(
            "--movie-delay",
            Math.min(index * 0.045, 0.5) + "s"
        );

        card.onclick = () => openMovieDetails(movie.id);

        card.innerHTML = `

            <div class="movie-poster-wrap">

                ${
                    poster
                    ? `<img
                        class="poster"
                        src="${poster}"
                        alt="${escapeHTML(title)}"
                        loading="lazy">`
                    : `<div class="poster movie-no-poster">
                        Z
                       </div>`
                }

                <div class="movie-card-overlay">
                    <span>VIEW DETAILS</span>
                </div>

                <span class="movie-card-rating">
                    ★ ${rating}
                </span>

            </div>

            <div class="card-info movie-card-info">

                <h3>${escapeHTML(title)}</h3>

                <div class="movie-card-meta">
                    <span>${year}</span>
                    <span>•</span>
                    <span>TMDB</span>
                </div>

            </div>
        `;

        grid.appendChild(card);
    });
}



/* ZOROX CINEMA: default movie feed */
function loadDefaultMovies(){
    loadMovieEndpoint("/api/movies/popular", "Popular Movies");
}


/* =========================
   MOVIE DETAILS

async function openMovieDetails(movieId){

    if(!movieId) return;

    showPage("movie-details");

    const detailsPage =
        document.getElementById("movieDetails");

    detailsPage.innerHTML = `
        <div class="movie-detail-loading">
            <div class="loader"></div>
            <p>Loading movie...</p>
        </div>
    `;

    try{

        const response = await fetch(
            API + "/api/movies/" + movieId
        );

        const data = await response.json();

        if(!response.ok || !data.success || !data.movie){
            throw new Error(data.error || "Movie details unavailable");
        }

        renderMovieDetails(data.movie, data.trailer);

    }catch(error){

        console.error(error);

        detailsPage.innerHTML = `
            <div class="movie-detail-error">
                <h2>Movie unavailable</h2>
                <p>Unable to load movie details.</p>

                <button
                    class="primary-btn"
                    onclick="showPage('movies')">
                    ← Back to Movies
                </button>
            </div>
        `;
    }
}


function renderMovieDetails(movie, trailer){

    const detailsPage = document.getElementById("movieDetails");

    const backdrop = movie.backdrop
        ? "https://image.tmdb.org/t/p/original" + movie.backdrop
        : "";

    const poster = movie.poster
        ? "https://image.tmdb.org/t/p/w500" + movie.poster
        : "";

    const year = movie.release_date
        ? movie.release_date.substring(0,4)
        : "—";

    const rating = movie.vote_average
        ? Number(movie.vote_average).toFixed(1)
        : "—";

    const genres = (movie.genres || [])
        .map(g => `<span>${escapeHTML(g.name)}</span>`)
        .join("");

    detailsPage.innerHTML = `

        <div class="zorox-movie-detail">

            <div class="movie-detail-backdrop"
                style="background-image:
                    linear-gradient(
                        90deg,
                        rgba(3,3,8,.98) 0%,
                        rgba(3,3,8,.82) 42%,
                        rgba(3,3,8,.30) 100%
                    ),
                    linear-gradient(
                        0deg,
                        rgba(3,3,8,1) 0%,
                        transparent 70%
                    ),
                    url('${backdrop}')">

                <button
                    class="movie-detail-back"
                    onclick="showPage('movies')">
                    ← Back to Movies
                </button>

                <div class="movie-detail-layout">

                    <div class="movie-detail-poster-box">

                        ${
                            poster
                            ? `<img
                                src="${poster}"
                                class="movie-detail-poster"
                                alt="${escapeHTML(movie.title || "Movie")}">`
                            : `<div class="movie-detail-no-poster">
                                ZOROX
                               </div>`
                        }

                    </div>

                    <div class="movie-detail-content">

                        <span class="movie-detail-kicker">
                            WIKRAMASINGHE TECHNOLOGIES / CINEMA CORE
                        </span>

                        <h1>
                            ${escapeHTML(movie.title || "Movie")}
                        </h1>

                        <div class="movie-detail-meta">

                            <span>${year}</span>

                            <span class="movie-rating">
                                ★ ${rating}
                            </span>

                            ${
                                movie.runtime
                                ? `<span>${movie.runtime} min</span>`
                                : ""
                            }

                        </div>

                        <div class="movie-detail-genres">
                            ${genres}
                        </div>

                        <p class="movie-detail-overview">
                            ${escapeHTML(
                                movie.overview ||
                                "No overview available."
                            )}
                        </p>

                        <div class="movie-detail-buttons">

                            ${
                                trailer && trailer.url
                                ? `
                                    <button
                                        class="movie-watch-btn"
                                        onclick="window.open(
                                            '${escapeJS(trailer.url)}',
                                            '_blank'
                                        )">
                                        ▶ Watch Trailer
                                    </button>
                                  `
                                : ""
                            }

                            <button
                                class="movie-save-btn"
                                onclick="toggleMovieSaved(${movie.id}, this)">
                                ♡ My List
                            </button>

                        </div>

