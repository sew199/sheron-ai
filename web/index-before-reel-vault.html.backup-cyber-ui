}


/* UI-only watchlist state for now.
   MongoDB watchlist can be connected next. */

function toggleMovieSaved(movieId, button){

    const key = "zorox_watchlist";
    let list = JSON.parse(localStorage.getItem(key) || "[]");

    if(list.includes(movieId)){

        list = list.filter(id => id !== movieId);
        button.innerHTML = "♡ My List";

    }else{

        list.push(movieId);
        button.innerHTML = "♥ Saved";

    }

    localStorage.setItem(key, JSON.stringify(list));
}


/* =========================
   MUSIC API
========================= */

async function searchMusic(){

    const query=
        document.getElementById("musicSearch")
        .value.trim();

    if(!query) return;

    const grid=document.getElementById("musicGrid");

    grid.innerHTML=
        '<div class="empty">Searching music...</div>';

    try{

        const response=await fetch(
            API + "/api/music/search?q=" +
            encodeURIComponent(query)
        );

        const data=await response.json();

        renderMusic(
            data.results || data.tracks || []
        );

    }catch(error){

        grid.innerHTML=
            '<div class="empty">Music search failed.</div>';

    }
}



function renderMusic(tracks){

    const grid = document.getElementById("musicGrid");

    if(!tracks || !tracks.length){
        grid.innerHTML =
            '<div class="empty">No music found.</div>';
        return;
    }

    grid.innerHTML = "";

    tracks.forEach((track,index)=>{

        const image =
            track.album_image ||
            track.image ||
            track.cover ||
            "";

        const title =
            track.name ||
            track.title ||
            "Unknown Track";

        const artist =
            track.artist_name ||
            track.artist ||
            "Unknown Artist";

        const album =
            track.album_name ||
            track.album ||
            "";

        const audio =
            track.audio ||
            track.audio_url ||
            "";

        const duration =
            Number(track.duration || 0);

        const minutes =
            Math.floor(duration / 60);

        const seconds =
            String(duration % 60).padStart(2,"0");

        const card = document.createElement("article");

        card.className = "media-card music-track-card";

        card.style.animationDelay =
            Math.min(index * 0.04,0.5) + "s";

        const cover = document.createElement("div");
        cover.className = "music-cover-wrap";

        if(image){

            const img = document.createElement("img");

            img.className = "album";
            img.src = image;
            img.alt = title;
            img.loading = "lazy";

            img.onerror = () => {
                img.style.display = "none";
                cover.classList.add("cover-fallback");
                cover.innerHTML =
                    '<span>♪</span>';
            };

            cover.appendChild(img);

        }else{

            cover.classList.add("cover-fallback");

            cover.innerHTML =
                '<span>♪</span>';

        }

        const info = document.createElement("div");

        info.className = "card-info";

        const titleEl = document.createElement("h3");
        titleEl.textContent = title;

        const artistEl = document.createElement("p");
        artistEl.textContent = artist;

        const meta = document.createElement("small");

        meta.textContent =
            album
            ? album + " • " + minutes + ":" + seconds
            : minutes + ":" + seconds;

        const play = document.createElement("button");

        play.className = "play";

        play.type = "button";

        play.innerHTML =
            '<span>▶</span> Play';

        play.onclick = (event) => {

            event.stopPropagation();

            if(audio){

                playTrack(
                    audio,
                    title,
                    artist,
                    image
                );

            }

        };

        info.appendChild(titleEl);
        info.appendChild(artistEl);
        info.appendChild(meta);

        if(audio){
            info.appendChild(play);
        }

        card.appendChild(cover);
        card.appendChild(info);

        grid.appendChild(card);

    });
}


function playTrack(url,title="",artist="",image=""){

    if(!url) return;

    let player =
        document.getElementById("zoroxAudio");

    if(!player){

        player =
            document.createElement("audio");

        player.id = "zoroxAudio";

        player.controls = true;

        document.body.appendChild(player);

    }

    player.src = url;

    player.dataset.title = title;
    player.dataset.artist = artist;
    player.dataset.image = image;

    player.play().catch(error=>{
        console.log("Playback:",error);
    });

    document
        .querySelector(".music-page")
        ?.classList.add("music-playing");

    player.onplay = () => {

        document
            .querySelector(".music-page")
            ?.classList.add("music-playing");

    };

    player.onpause = () => {

        document
            .querySelector(".music-page")
            ?.classList.remove("music-playing");

    };

    player.onended = () => {

        document
            .querySelector(".music-page")
            ?.classList.remove("music-playing");

    };
}


