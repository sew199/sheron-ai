    if (!menu || !overlay) return;

    menu.classList.remove("active");
    overlay.classList.remove("active");

    document.body.style.overflow = "";
}

document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
        closeZoroxSideMenu();
    }
});
