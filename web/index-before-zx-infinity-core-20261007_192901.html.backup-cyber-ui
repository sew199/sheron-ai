<script id="zorox-user-menu-js">

function toggleUserMenu(){
  const panel = document.getElementById("zUserPanel");
  if(panel) panel.classList.toggle("open");
  loadZoroxUser();
}

function loadZoroxUser(){

  let user = {};

  try{
    user = JSON.parse(localStorage.getItem("zoroxUser") || "{}");
  }catch(e){
    user = {};
  }

  const name = user.name || localStorage.getItem("name") || "ZOROX USER";
  const email = user.email || localStorage.getItem("email") || "Not signed in";
  const phone = user.phone || localStorage.getItem("phone") || "Not added";
  const coins = Number(user.coins ?? localStorage.getItem("coins") ?? 0);

  document.getElementById("zUserName").textContent = name;
  document.getElementById("zUserEmail").textContent = email;

  document.getElementById("zDetailName").textContent = name;
  document.getElementById("zDetailPhone").textContent = phone;
  document.getElementById("zDetailEmail").textContent = email;
  document.getElementById("zCoinBalance").textContent = coins;

  const photo = user.photo || localStorage.getItem("zoroxProfilePhoto");

  if(photo){
    document.getElementById("zProfilePhoto").src = photo;
    document.getElementById("zUserAvatar").textContent = "";
  }else{
    document.getElementById("zProfilePhoto").src =
      "data:image/svg+xml;charset=UTF-8," +
      encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200">' +
        '<rect width="100%" height="100%" fill="#0b1020"/>' +
        '<text x="50%" y="58%" text-anchor="middle" font-size="85" fill="#6d8cff">👤</text>' +
        '</svg>'
      );
    document.getElementById("zUserAvatar").textContent = "👤";
  }
}

function changeZoroxPhoto(event){

  const file = event.target.files[0];

  if(!file) return;

  if(!file.type.startsWith("image/")){
    alert("Please select an image.");
    return;
  }

  const reader = new FileReader();

  reader.onload = function(e){

    const photo = e.target.result;

    localStorage.setItem("zoroxProfilePhoto", photo);

    let user = {};

    try{
      user = JSON.parse(localStorage.getItem("zoroxUser") || "{}");
    }catch(e){
      user = {};
    }

    user.photo = photo;

    localStorage.setItem("zoroxUser", JSON.stringify(user));

    loadZoroxUser();
  };

  reader.readAsDataURL(file);
}

function editZoroxProfile(){

  let user = {};

  try{
    user = JSON.parse(localStorage.getItem("zoroxUser") || "{}");
  }catch(e){
    user = {};
  }

  const name = prompt("Enter your name:", user.name || "");
  if(name === null) return;

  const phone = prompt("Enter your phone number:", user.phone || "");
  if(phone === null) return;

  user.name = name.trim();
  user.phone = phone.trim();

  localStorage.setItem("zoroxUser", JSON.stringify(user));
  localStorage.setItem("name", user.name);
  localStorage.setItem("phone", user.phone);

  loadZoroxUser();
}

function zoroxLogout(){

  if(!confirm("Log out from ZOROX?")) return;

  localStorage.removeItem("zoroxUser");
  localStorage.removeItem("name");
  localStorage.removeItem("phone");
  localStorage.removeItem("email");
  localStorage.removeItem("coins");
  localStorage.removeItem("zoroxProfilePhoto");

  window.location.href = "login.html";
}

document.addEventListener("DOMContentLoaded", loadZoroxUser);

</script>


<script id="zorox-nav-user-js">

function updateZoroxNavUser(){

    const btn = document.getElementById("zx-user-menu-btn");
    const avatar = document.getElementById("zx-nav-avatar");

    if(!btn || !avatar) return;

    let user = {};

    try{
        user = JSON.parse(localStorage.getItem("zoroxUser") || "{}");
    }catch(e){
        user = {};
    }

    const token =
        localStorage.getItem("token") ||
        localStorage.getItem("zoroxToken");

    const logged =
        !!token ||
        !!user.email ||
        !!localStorage.getItem("email");

    if(!logged){
        btn.classList.remove("logged-in");
        avatar.textContent = "👤";
        return;
    }

    const photo =
        user.photo ||
        localStorage.getItem("zoroxProfilePhoto");

    btn.classList.add("logged-in");

    if(photo){
        avatar.innerHTML =

            photo.replace(/"/g,"&quot;") +
            '" alt="User">';
    }else{
        avatar.textContent = "👤";
    }
}

document.addEventListener("DOMContentLoaded", updateZoroxNavUser);

window.addEventListener("storage", updateZoroxNavUser);

</script>


