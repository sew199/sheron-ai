<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>WIKRAMASINGHE TECHNOLOGIES</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #020409;
    color: #fff;
    min-height: 100vh;
    overflow-x: hidden;
}

/* =========================
   BACKGROUND
========================= */

body::before {
    content: "";
    position: fixed;
    width: 700px;
    height: 700px;
    left: -250px;
    top: -250px;

    background:
        radial-gradient(
            circle,
            rgba(0, 220, 255, .14),
            transparent 68%
        );

    pointer-events: none;
    z-index: -5;
}

body::after {
    content: "";
    position: fixed;
    width: 700px;
    height: 700px;
    right: -300px;
    bottom: -300px;

    background:
        radial-gradient(
            circle,
            rgba(105, 60, 255, .15),
            transparent 68%
        );

    pointer-events: none;
    z-index: -5;
}

/* =========================
   GRID BACKGROUND
========================= */

.grid-bg {
    position: fixed;
    inset: 0;

    background-image:
        linear-gradient(
            rgba(255,255,255,.025) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.025) 1px,
            transparent 1px
        );

    background-size: 50px 50px;

    mask-image:
        linear-gradient(
            to bottom,
            black,
            transparent 90%
        );

    pointer-events: none;
    z-index: -4;
}

/* =========================
   FLOATING BUBBLES
========================= */

.bubble {
    position: fixed;
    border-radius: 50%;

    background: rgba(0, 210, 255, .025);

    border: 1px solid rgba(0, 220, 255, .10);

    box-shadow:
        inset 0 0 20px rgba(0,220,255,.03),
        0 0 30px rgba(0,220,255,.03);

    backdrop-filter: blur(4px);

    animation: floating 9s infinite ease-in-out;

    pointer-events: none;

    z-index: -2;
}

.b1 {
    width: 110px;
    height: 110px;
    top: 15%;
    left: 5%;
}

.b2 {
    width: 45px;
    height: 45px;
    top: 60%;
    left: 15%;
    animation-delay: 2s;
}

.b3 {
    width: 140px;
    height: 140px;
    top: 25%;
    right: 5%;
    animation-delay: 1s;
}

.b4 {
    width: 60px;
    height: 60px;
    bottom: 15%;
    right: 17%;
    animation-delay: 3s;
}

.b5 {
    width: 30px;
    height: 30px;
    top: 45%;
    right: 30%;
    animation-delay: 4s;
}

@keyframes floating {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-30px);
    }
}

/* =========================
   HEADER
========================= */

header {
    position: sticky;
    top: 0;

    width: 100%;

    padding: 18px 6%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    background: rgba(2,4,9,.72);

    backdrop-filter: blur(25px);

    border-bottom:
        1px solid rgba(255,255,255,.06);

    z-index: 100;
}

/* LOGO */

.brand {
    display: flex;
    align-items: center;
    gap: 12px;

    cursor: pointer;
}

.logo {
    width: 43px;
    height: 43px;

    border-radius: 13px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #00eaff,
            #654cff
        );

    color: #020409;

    font-size: 25px;
    font-weight: 900;

    box-shadow:
        0 0 30px rgba(0,220,255,.30);
}

.brand-text {
    font-size: 15px;

    font-weight: 900;

    letter-spacing: 2px;
}

.brand-text span {
    color: #00dcff;
}

/* NAVIGATION */

nav {
    display: flex;
    gap: 28px;
}

nav a {
    position: relative;

    color: #8f9aaa;

    text-decoration: none;

    font-size: 14px;

    transition: .3s;
}

nav a:hover {
    color: #fff;
}

nav a::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -8px;

    width: 0;
    height: 2px;

    background: #00dcff;

    transition: .3s;
}

nav a:hover::after {
    width: 100%;
}

/* =========================
   HERO
========================= */

.hero {

    min-height: 86vh;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 80px 20px;

    position: relative;
}

.hero-content {
    max-width: 900px;
}

/* BADGE */

.badge {

    display: inline-flex;

    align-items: center;

    gap: 9px;

    padding: 9px 18px;

    border:
        1px solid rgba(0,220,255,.20);

    border-radius: 50px;

    background:
        rgba(0,220,255,.04);

    color: #66eaff;

    font-size: 11px;

    letter-spacing: 2px;

    margin-bottom: 28px;
}

.badge-dot {

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #00eaff;

    box-shadow:
        0 0 12px #00eaff;

    animation: pulse 1.8s infinite;
}

@keyframes pulse {

    0%,100% {
        opacity: 1;
    }

    50% {
        opacity: .3;
    }
}

/* TITLE */

h1 {

    font-size:
        clamp(50px, 10vw, 110px);

    line-height: .90;

    font-weight: 900;

    letter-spacing: -6px;
}

.gradient {

    background:
        linear-gradient(
            90deg,
            #fff,
            #00eaff,
            #7d63ff
        );

    -webkit-background-clip: text;

    -webkit-text-fill-color: transparent;
}

/* SUBTITLE */

.subtitle {

    max-width: 680px;

    margin:
        32px auto;

    color: #8490a1;

    font-size: 17px;

    line-height: 1.7;
}

/* BUTTONS */

.buttons {

    display: flex;

    justify-content: center;

    gap: 14px;

    flex-wrap: wrap;
}

.btn {

    border: none;

    padding:
        15px 25px;

    border-radius: 13px;

    text-decoration: none;

    font-weight: 800;

    font-size: 14px;

    cursor: pointer;

    transition: .3s;
}

.primary {

    color: #001016;

    background:
        linear-gradient(
            90deg,
            #00eaff,
            #73f4ff
        );

    box-shadow:
        0 0 30px rgba(0,220,255,.18);
}

.secondary {

    color: white;

    border:
        1px solid rgba(255,255,255,.12);

    background:
        rgba(255,255,255,.04);
}

.btn:hover {

    transform:
        translateY(-4px);

    box-shadow:
        0 12px 40px rgba(0,0,0,.35);
}

/* =========================
   SERVICES
========================= */

.services {

    padding:
        40px 7% 100px;

    position: relative;

    z-index: 2;
}

.section-title {

    text-align: center;

    margin-bottom: 45px;
}

.section-title h2 {

    font-size: 38px;

    margin-bottom: 12px;
}

.section-title p {

    color: #707b8b;

    font-size: 14px;
}

.cards {

    max-width: 1150px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 20px;
}

.card {

    padding: 30px;

    min-height: 220px;

    border:
        1px solid rgba(255,255,255,.07);

    border-radius: 23px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.055),
            rgba(255,255,255,.012)
        );

    backdrop-filter: blur(18px);

    transition: .35s;

    position: relative;

    overflow: hidden;
}

.card::before {

    content: "";

    position: absolute;

    width: 120px;
    height: 120px;

    top: -60px;
    right: -60px;

    background:
        radial-gradient(
            circle,
            rgba(0,220,255,.15),
            transparent 70%
        );
}

.card:hover {

    transform:
        translateY(-9px);

    border-color:
        rgba(0,220,255,.28);

    box-shadow:
        0 25px 70px rgba(0,0,0,.35);
}

.icon {

    width: 50px;
    height: 50px;

    border-radius: 15px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 23px;

    color: #00eaff;

    background:
        rgba(0,220,255,.07);

    border:
        1px solid rgba(0,220,255,.13);

    margin-bottom: 22px;
}

.card h3 {

    font-size: 19px;

    margin-bottom: 12px;
}

.card p {

    color: #798596;

    font-size: 13px;

    line-height: 1.7;
}

/* =========================
   AI SECTION
========================= */

#aiSection {

    display: none;

    min-height: 100vh;

    padding:
        40px 6% 80px;

    position: relative;
}

.ai-container {

    max-width: 900px;

    margin: auto;
}

.ai-header {

    text-align: center;

    margin-bottom: 30px;
}

.ai-logo {

    width: 70px;
    height: 70px;

    margin: auto auto 18px;

    border-radius: 22px;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 30px;

    font-weight: 900;

    background:
        linear-gradient(
            135deg,
            #00eaff,
            #754dff
        );

    color: #020409;

    box-shadow:
        0 0 40px rgba(0,220,255,.25);
}

.ai-header h2 {

    font-size: 38px;

    margin-bottom: 8px;
}

.ai-header p {

    color: #778293;

    font-size: 14px;
}

/* STATUS */

.ai-status {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-top: 13px;

    color: #68eaff;

    font-size: 11px;
}

.status-dot {

    width: 7px;
    height: 7px;

    background: #00eaff;

    border-radius: 50%;

    box-shadow:
        0 0 10px #00eaff;
}

/* CHAT */

.chat-box {

    height: 560px;

    border:
        1px solid rgba(255,255,255,.08);

    border-radius: 25px;

    background:
        rgba(7,10,17,.72);

    backdrop-filter:
        blur(25px);

    display: flex;

    flex-direction: column;

    overflow: hidden;

    box-shadow:
        0 30px 100px rgba(0,0,0,.35);
}

.chat-top {

    padding: 18px 22px;

    border-bottom:
        1px solid rgba(255,255,255,.06);

    display: flex;

    justify-content: space-between;

    align-items: center;
}

.chat-title {

    display: flex;

    align-items: center;

    gap: 10px;
}

.mini-logo {

    width: 34px;
    height: 34px;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            #00eaff,
            #654cff
        );

    color: #020409;

    display: flex;

    align-items: center;

    justify-content: center;

    font-weight: 900;
}

.chat-name {

    font-size: 14px;

    font-weight: 800;
}

.chat-online {

    color: #5f6b7b;

    font-size: 10px;

    margin-top: 3px;
}

.close-ai {

    border: none;

    background:
        rgba(255,255,255,.05);

    color: #9ba6b5;

    width: 35px;
    height: 35px;

    border-radius: 10px;

    cursor: pointer;

    font-size: 18px;

    transition: .2s;
}

.close-ai:hover {

    background:
        rgba(255,255,255,.10);

    color: white;
}

/* MESSAGES */

.messages {

    flex: 1;

    padding: 25px;

    overflow-y: auto;

    display: flex;

    flex-direction: column;

    gap: 15px;
}

.message {

    max-width: 78%;

    padding:
        13px 16px;

    border-radius: 17px;

    font-size: 14px;

    line-height: 1.6;

    animation:
        messageIn .25s ease;
}

@keyframes messageIn {

    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.ai-message {

    align-self: flex-start;

    background:
        rgba(255,255,255,.055);

    border:
        1px solid rgba(255,255,255,.06);

    color: #d8dee8;

    border-bottom-left-radius: 5px;
}

.user-message {

    align-self: flex-end;

    background:
        linear-gradient(
            135deg,
            #00cfe8,
            #6450e8
        );

    color: white;

    border-bottom-right-radius: 5px;
}

/* TYPING */

.typing {

    display: flex;

    gap: 4px;

    padding: 4px;
}

.typing span {

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #00dcff;

    animation:
        typing 1s infinite;
}

.typing span:nth-child(2) {
    animation-delay: .15s;
}

.typing span:nth-child(3) {
    animation-delay: .3s;
}

@keyframes typing {

    0%,100% {
        opacity: .25;
    }

    50% {
        opacity: 1;
    }
}

/* CHAT INPUT */

.chat-input-area {

    padding: 15px;

    border-top:
        1px solid rgba(255,255,255,.06);

    display: flex;

    gap: 10px;
}

.chat-input {

    flex: 1;

    border:
        1px solid rgba(255,255,255,.09);

    outline: none;

    background:
        rgba(255,255,255,.035);

    color: white;

    padding:
        14px 16px;

    border-radius: 13px;

    font-size: 14px;
}

.chat-input::placeholder {
    color: #596576;
}

.send-btn {

    width: 50px;

    border: none;

    border-radius: 13px;

    cursor: pointer;

    background:
        linear-gradient(
            135deg,
            #00eaff,
            #7354ff
        );

    color: #020409;

    font-size: 18px;

    font-weight: 900;

    transition: .2s;
}

.send-btn:hover {
    transform: scale(1.05);
}

/* =========================
   TECHNOLOGY
========================= */

#technology {

    padding:
        80px 7%;

    text-align: center;
}

.tech-content {

    max-width: 900px;

    margin: auto;
}

.tech-content h2 {

    font-size: 40px;

    margin-bottom: 15px;
}

.tech-content p {

    color: #7b8798;

    line-height: 1.8;

    font-size: 15px;
}

/* =========================
   ABOUT
========================= */

#about {

    padding:
        80px 7%;

    text-align: center;
}

.about-box {

    max-width: 850px;

    margin: auto;

    padding: 45px;

    border:
        1px solid rgba(255,255,255,.07);

    border-radius: 25px;

    background:
        rgba(255,255,255,.025);

    backdrop-filter: blur(15px);
}

.about-box h2 {

    font-size: 36px;

    margin-bottom: 18px;
}

.about-box p {

    color: #7d8999;

    line-height: 1.8;

    font-size: 14px;
}

/* =========================
   FOOTER
========================= */

footer {

    text-align: center;

    padding: 45px 20px;

    border-top:
        1px solid rgba(255,255,255,.06);

    color: #515c6b;

    font-size: 12px;
}

.footer-brand {

    color: #00dcff;

    font-weight: 900;

    letter-spacing: 3px;

    margin-bottom: 10px;
}

.creator {

    margin-top: 9px;

    color: #46515f;
}

.creator span {

    color: #8b96a5;
}

/* =========================
   MOBILE
========================= */

@media(max-width: 750px) {

    header {

        padding:
            16px 5%;
    }

    nav {
        display: none;
    }

    h1 {

        font-size:
            clamp(48px, 16vw, 80px);

        letter-spacing:
            -4px;
    }

    .subtitle {

        font-size: 14px;
    }

    .cards {

        grid-template-columns:
            1fr;
    }

    .hero {

        min-height: 78vh;

        padding:
            60px 20px;
    }

    .chat-box {

        height: 600px;
    }

    .message {

        max-width: 88%;
    }

    .ai-header h2 {

        font-size: 32px;
    }

    .about-box {

        padding: 30px 20px;
    }
}


/* =========================
   ZOROX.AI MOBILE UPGRADE
========================= */

@media (max-width: 600px) {

    .chat-top {
        padding: 18px 16px !important;
    }

    .mini-logo {
        width: 48px !important;
        height: 48px !important;
        font-size: 22px !important;
    }

    .chat-name {
        font-size: 20px !important;
        font-weight: 700 !important;
    }

    .chat-online {
        font-size: 12px !important;
    }

    .messages {
        flex: 1 !important;
        min-height: 0 !important;
        padding: 18px 14px !important;
        overflow-y: auto !important;
    }

    .message {
        max-width: 88% !important;
        font-size: 15px !important;
        line-height: 1.55 !important;
        padding: 13px 15px !important;
    }

    .chat-input-area {
        padding: 12px !important;
        gap: 10px !important;
    }

    .chat-input {
        height: 52px !important;
        font-size: 16px !important;
        padding: 0 16px !important;
        border-radius: 18px !important;
    }

    .send-btn {
        width: 52px !important;
        height: 52px !important;
        min-width: 52px !important;
        border-radius: 18px !important;
        font-size: 20px !important;
    }

    .footer-brand {
        letter-spacing: 3px !important;
        font-weight: 800 !important;
    }
}


/* =========================
   WIKRAMASINGHE TECHNOLOGIES LOGO
========================= */

.mini-logo {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: linear-gradient(135deg, #00e5ff, #7c4dff) !important;
    color: #ffffff !important;
    border-radius: 15px !important;
    font-size: 0 !important;
    font-weight: 900 !important;
    box-shadow:
        0 0 18px rgba(0, 229, 255, 0.35),
        0 0 28px rgba(124, 77, 255, 0.25) !important;
}

.mini-logo::after {
    content: "Y";
    font-size: 25px;
    font-weight: 900;
    color: #ffffff;
}

.footer-brand {
    font-weight: 900 !important;
    letter-spacing: 4px !important;
}


.music-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-sizing: border-box;
}

.music-button:hover {
    transform: none;
}




