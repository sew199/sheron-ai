<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ZOROX AI — WIKRAMASINGHE TECHNOLOGIES</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: Arial, Helvetica, sans-serif;
    color: white;
    background:
        radial-gradient(circle at 15% 10%, rgba(0,220,255,.12), transparent 30%),
        radial-gradient(circle at 85% 90%, rgba(100,70,255,.12), transparent 30%),
        #020409;
}

header {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(2,4,9,.8);
    backdrop-filter: blur(20px);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 21px;
    color: #020409;
    background: linear-gradient(135deg,#00eaff,#654cff);
    box-shadow: 0 0 25px rgba(0,220,255,.3);
}

.brand-text {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 2px;
}

.brand-text span {
    color: #00eaff;
}

main {
    width: min(950px, calc(100% - 24px));
    margin: 35px auto;
}

.hero {
    text-align: center;
    margin-bottom: 24px;
}

.hero h1 {
    font-size: clamp(34px, 8vw, 62px);
    letter-spacing: 4px;
}

.hero h1 span {
    color: #00eaff;
}

.hero p {
    margin-top: 8px;
    color: #8e9aaa;
}

.chat-panel {
    height: 500px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 25px;
    background: rgba(7,10,17,.82);
    box-shadow: 0 20px 80px rgba(0,0,0,.35);
}

.chat-header {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    display: flex;
    align-items: center;
    gap: 10px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00eaff;
    box-shadow: 0 0 12px #00eaff;
}

.chat-header strong {
    font-size: 14px;
}

.messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
}

.message {
    max-width: 85%;
    padding: 11px 14px;
    margin-bottom: 11px;
    border-radius: 15px;
    line-height: 1.5;
    white-space: pre-wrap;
}

.message.user {
    margin-left: auto;
    background: rgba(0,220,255,.13);
    border: 1px solid rgba(0,220,255,.2);
}

.message.ai {
    background: rgba(255,255,255,.055);
    border: 1px solid rgba(255,255,255,.07);
}

.typing {
    display: flex;
    gap: 5px;
    padding: 7px 2px;
}

.typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00eaff;
    animation: blink 1.2s infinite;
}

.typing span:nth-child(2) {
    animation-delay: .15s;
}

.typing span:nth-child(3) {
    animation-delay: .3s;
}

@keyframes blink {
    0%,100% { opacity: .2; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-3px); }
}

.input-area {
    display: flex;
    gap: 9px;
    padding: 10px;
    border-top: 1px solid rgba(255,255,255,.07);
}

#messageInput {
    flex: 1;
    min-width: 0;
    height: 45px;
    padding: 0 14px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 13px;
    outline: none;
    color: white;
    background: rgba(255,255,255,.045);
}

#messageInput:focus {
    border-color: rgba(0,220,255,.5);
}

#sendButton {
    width: 45px;
    height: 45px;
    border: none;
    border-radius: 13px;
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    color: #020409;
    background: linear-gradient(135deg,#00eaff,#654cff);
}

#sendButton:disabled {
    opacity: .5;
    cursor: default;
}

footer {
    text-align: center;
    padding: 25px;
    color: #657080;
    font-size: 12px;
}

@media (max-width: 600px) {
    header {
        padding: 0 15px;
    }

    main {
        width: calc(100% - 16px);
        margin-top: 20px;
    }

    .chat-panel {
        height: 470px;
        border-radius: 20px;
    }

    .message {
        max-width: 92%;
    }
}
</style>
</head>

<body>

<header>
    <div class="brand">
        <div class="logo">Z</div>
        <div class="brand-text">
            WIKRAMASINGHE <span>TECHNOLOGIES</span>
        </div>
    </div>
</header>

<main>

    <section class="hero">
        <h1><span>ZOROX</span> AI</h1>
        <p>Intelligent. Fast. Built by WIKRAMASINGHE TECHNOLOGIES.</p>
    </section>

    <section class="chat-panel">

        <div class="chat-header">
            <div class="status-dot"></div>
            <strong>ZOROX AI · ONLINE</strong>
        </div>

        <div id="messages" class="messages">
            <div class="message ai">
                Hello! I'm ZOROX AI. How can I help you?
            </div>
        </div>

        <div class="input-area">
            <input
                id="messageInput"
                type="text"
                placeholder="Message ZOROX AI..."
                autocomplete="off"
            >
            <button id="sendButton">➤</button>
        </div>

    </section>

</main>

<footer>
    © 2026 WIKRAMASINGHE TECHNOLOGIES · ZOROX AI
</footer>

<script>
const messages = document.getElementById("messages");
const input = document.getElementById("messageInput");
const sendButton = document.getElementById("sendButton");

const API_URL =
    (location.hostname === "localhost" ||
     location.hostname === "127.0.0.1")
    ? "http://127.0.0.1:5000"
    : "https://YOUR-BACKEND-URL";

function addMessage(text, type) {
    const div = document.createElement("div");
    div.className = "message " + type;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
}

function showTyping() {
    const div = document.createElement("div");
    div.className = "message ai";
    div.id = "typingMessage";

    div.innerHTML = `
        <div class="typing">
            <span></span>
            <span></span>
            <span></span>
        </div>
    `;

    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
}

function removeTyping() {
    const typing = document.getElementById("typingMessage");
    if (typing) typing.remove();
}

async function sendMessage() {
    const message = input.value.trim();

    if (!message || sendButton.disabled) return;

    addMessage(message, "user");

    input.value = "";
    sendButton.disabled = true;

    showTyping();

    try {
        const response = await fetch(API_URL + "/api/chat", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                message: message
            })
        });

        const data = await response.json();

        removeTyping();

        if (!response.ok) {
            addMessage(
                data.error || "ZOROX AI could not process your message.",
                "ai"
            );
            return;
        }

        addMessage(
            data.reply || "No response received.",
            "ai"
        );

    } catch (error) {
        removeTyping();

        addMessage(
            "Connection error. Make sure the ZOROX backend is running.",
            "ai"
        );

        console.error(error);

    } finally {
        sendButton.disabled = false;
        input.focus();
    }
}

sendButton.addEventListener("click", sendMessage);

input.addEventListener("keydown", function(event) {
    if (event.key === "Enter") {
        sendMessage();
    }
});
</script>

</body>
</html>
