<body>
<header>
  <div class="brand"><div class="logo">Z</div><div>ZOROX <small>MOVIES</small></div></div>
  <nav><a href="index.html">ZOROX AI</a><a href="#discover">Discover</a><a class="back" href="index.html">← Back</a></nav>
</header>

<section class="hero">
  <div class="heroGrid"></div><div class="heroGlow"></div><div class="filmRing"></div>
  <div class="heroContent">
    <div class="kicker">WIKRAMASINGHE TECHNOLOGIES / CINEMA CORE</div>
    <h1>ENTER<br><span>THE MOVIE</span><br>WORLD.</h1>
    <p>Discover cinematic worlds, legendary stories and the movies everyone's talking about — powered by ZOROX.</p>
    <div class="search"><input id="q" placeholder="Search movies... e.g. Inception, Interstellar, Dune"><button onclick="searchMovies()">SEARCH</button></div>
    <div class="scroll">SCROLL TO DISCOVER ↓</div>
  </div>
</section>

<section class="section" id="discover">
  <div class="sectionHead"><div><span>EXPLORE</span><h2>Movie Universe</h2></div><span id="count"></span></div>
  <div id="loader">SEARCHING CINEMA DATABASE...</div>
  <div class="grid" id="grid"><div class="empty">Search for a movie to enter the ZOROX cinema database.</div></div>
</section>

<div class="modal" id="modal">
  <div class="cinema-page">

    <div class="cinema-backdrop" id="detailTop">
      <div class="cinema-shade"></div>
      <button class="cinema-back" type="button" onclick="closeModal()">
        <span>←</span> BACK
      </button>

      <div class="cinema-content">
        <div class="cinema-kicker">ZOROX CINEMA / MOVIE PROFILE</div>
        <h2 id="dt">Movie Title</h2>

        <div class="cinema-tags" id="tags"></div>

        <p class="cinema-overview" id="do">
          No overview available.
        </p>

        <div class="cinema-stats">
          <div>
            <span>RATING</span>
            <b id="dr">★ 0.0/10</b>
          </div>
          <div>
            <span>RELEASE</span>
            <b id="dd">N/A</b>
          </div>
          <div>
            <span>VOTES</span>
            <b id="dv">0</b>
          </div>
        </div>

        <div class="cinema-actions">
          <a id="trailer"
             class="cinema-btn cinema-red"
             target="_blank"
             rel="noopener">
            ▶ WATCH TRAILER
          </a>

          <button class="cinema-btn cinema-dark"
                  type="button"
                  id="downloadMain">
            ↓ DOWNLOAD MOVIE
          </button>
        </div>

        <div class="zx-quality" id="qualityBox">
          <button type="button" onclick="requestMovieDownload('480p',this)">
            <b>480p</b>
            <small>SD</small>
          </button>

          <button type="button" onclick="requestMovieDownload('720p',this)">
            <b>720p</b>
            <small>HD</small>
          </button>

          <button type="button" onclick="requestMovieDownload('1080p',this)">
            <b>1080p</b>
            <small>FULL HD</small>
          </button>
        </div>

        <div class="zx-download-status" id="downloadStatus">
          <i></i>
          <span id="downloadStatusText">Choose a quality</span>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
const API_BASE=window.location.hostname==="localhost"||window.location.hostname==="127.0.0.1"?"http://127.0.0.1:5000":"http://"+window.location.hostname+":5000";
const IMG="https://image.tmdb.org/t/p/w500";
const BACK="https://image.tmdb.org/t/p/w1280";
let movies=[]; let selectedMovie=null;
async function searchMovies(){
 const q=document.getElementById("q").value.trim(); if(!q)return;
 const loader=document.getElementById("loader"),grid=document.getElementById("grid");
 loader.style.display="block";grid.innerHTML="";
 try{
  const r=await fetch(API_BASE+"/api/movies/search?q="+encodeURIComponent(q));
  const d=await r.json();
  if(!r.ok)throw new Error(d.error||"Search failed");
  movies=d.results||[];document.getElementById("count").textContent=movies.length+" RESULTS";
  if(!movies.length){grid.innerHTML='<div class="empty">No movies found.</div>';return}
  movies.forEach((m,i)=>{
   if(!m.poster_path)return;
   const c=document.createElement("div");c.className="card";c.style.animationDelay=(i*.035)+"s";
   c.innerHTML='<div class="poster"><img src="'+IMG+m.poster_path+'" loading="lazy"><div class="overlay"><div class="play">▶</div></div></div><div class="info"><h3>'+esc(m.title)+'</h3><div class="meta"><span class="rating">★ '+(m.vote_average||0).toFixed(1)+'</span> · '+(m.release_date||"N/A").slice(0,4)+'</div></div>';
   c.onclick=()=>openMovie(m);grid.appendChild(c);
  });
 }catch(e){grid.innerHTML='<div class="empty">Movie connection error.<br>'+esc(e.message)+'</div>'}
 finally{loader.style.display="none"}
}
function openMovie(m){
 selectedMovie=m;
 document.getElementById("dt").textContent=m.title||"Untitled";
 document.getElementById("do").textContent=m.overview||"No overview available.";
 document.getElementById("dr").textContent="★ "+(m.vote_average||0).toFixed(1)+"/10";
 document.getElementById("dd").textContent=m.release_date||"N/A";
 document.getElementById("dv").textContent=(m.vote_count||0).toLocaleString();
 document.getElementById("detailTop").style.backgroundImage=m.backdrop_path?"url("+BACK+m.backdrop_path+")":"linear-gradient(135deg,#220008,#080808)";
 document.getElementById("tags").innerHTML=(m.genre_ids||[]).map(x=>'<span class="tag">Genre '+x+'</span>').join("");
 document.getElementById("trailer").href="https://www.youtube.com/results?search_query="+encodeURIComponent(m.title+" official trailer");
 document.getElementById("modal").classList.add("show");document.body.style.overflow="hidden";
}
function closeModal(){document.getElementById("modal").classList.remove("show");document.body.style.overflow=""}
document.getElementById("q").addEventListener("keydown",e=>{if(e.key==="Enter")searchMovies()});
function esc(x){return String(x??"").replace(/[&<>"']/g,a=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[a]))}

const downloadMain=document.getElementById("downloadMain");
const qualityBox=document.getElementById("qualityBox");

if(downloadMain){
  downloadMain.addEventListener("click",()=>{
    qualityBox.classList.toggle("show");
  });
}

async function requestMovieDownload(quality,button){
  const status=document.getElementById("downloadStatus");
  const statusText=document.getElementById("downloadStatusText");

  if(!selectedMovie || !selectedMovie.id){
    status.classList.add("show");
    statusText.textContent="Movie ID not available.";
    return;
  }

  document.querySelectorAll(".zx-quality button").forEach(b=>{
    b.disabled=true;
    b.style.opacity=".55";
  });

  status.classList.add("show");
  statusText.textContent="Preparing "+quality+"...";

  try{
    const r=await fetch(
      API_BASE+"/api/movies/download?movie_id="+
      encodeURIComponent(selectedMovie.id)+
      "&quality="+encodeURIComponent(quality)
    );

    const d=await r.json();

    if(!r.ok || !d.url){
      statusText.textContent=d.message||"Download source unavailable.";
      return;
    }

    statusText.textContent="Download ready — "+quality;
    window.location.href=d.url;

  }catch(e){
    console.error(e);
    statusText.textContent="Download service unavailable.";
  }finally{
    document.querySelectorAll(".zx-quality button").forEach(b=>{
      b.disabled=false;
      b.style.opacity="";
    });
  }
}

</script>



</body>
</html>
